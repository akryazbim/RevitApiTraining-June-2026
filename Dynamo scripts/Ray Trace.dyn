    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\nimport clr\r\nimport sys\r\n\r\n# Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# Optional Namespaces\r\nfrom Autodesk.Revit.DB.Architecture import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n# Dynamo Services\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"System\")\r\nfrom System.Collections.Generic import List\r\n\r\n# Dynamo Geometry (Only if needed)\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\nuidoc = uiapp.ActiveUIDocument\r\napp = uiapp.Application\r\n\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\ndata = IN[0]\r\n\r\n# ==========================\r\n# CODE\r\n# ==========================\r\nimport os\r\n\r\nbaseFolder = r\"C:\\Users\\v.aditya\\Projects\\Architecture\"\r\npdfFolder = os.path.join(baseFolder, \"PDF\")\r\ndwgFolder = os.path.join(baseFolder, \"DWG\")\r\n\r\n\r\nos.makedirs(pdfFolder, exist_ok=True)\r\nos.makedirs(dwgFolder, exist_ok=True)\r\n\r\n\r\npdfops = PDFExportOptions()\r\npdfops.Combine = True\r\ndwgops = DWGExportOptions()\r\ndwgops.MergedViews = True\r\n\r\nviewSheets = FilteredElementCollector(doc).OfClass(ViewSheet).ToElements()\r\n\r\nfor viewSheet in viewSheets:\r\n    sheetList = List[ElementId]()\r\n    sheetList.Add(viewSheet.Id)\r\n    if \"Floor Plan\" in viewSheet.Name:\r\n        name = pdfops.FileName = \"Level\"+viewSheet.SheetNumber+\"-\"+viewSheet.Name\r\n        pdfs = doc.Export(pdfFolder, sheetList, pdfops)\r\n        dwgs = doc.Export(dwgFolder, name, sheetList, dwgops)\r\n\r\n# ==========================\r\n# OUTPUT\r\n# ==========================\r\n\r\n\r\n\r\nOUT = a",
