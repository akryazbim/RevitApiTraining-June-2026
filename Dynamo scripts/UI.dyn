    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\nimport clr\r\nimport sys\r\n\r\n# Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# Namespaces\r\nfrom Autodesk.Revit.DB.Architecture import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n# Dynamo Services\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"System\")\r\nfrom System.Collections.Generic import List\r\n\r\n# Dynamo Geometry (Only if needed)\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\nuidoc = uiapp.ActiveUIDocument\r\napp = uiapp.Application\r\n\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\ndesk = UnwrapElement(IN[0])\r\n\r\n# ==========================\r\n# CODE\r\n# ==========================\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nview3Ds = FilteredElementCollector(doc).OfClass(View3D).ToElements()\r\n\r\nfor view3D in view3Ds:\r\n    if view3D.Name == \"{3D}\":\r\n        myView = view3D\r\n\r\nrI = ReferenceIntersector(myView)\r\n\r\nloc = desk.Location.Point #.ToPoint()\r\n\r\ndesktype = doc.GetElement(desk.GetTypeId())\r\ndeskDepth = desktype.LookupParameter(\"Depth\").AsDouble()\r\ndeskpoint1 = XYZ(loc.X+(deskDepth/2), loc.Y, loc.Z)#.ToPoint()\r\ndeskpoint2 = XYZ(loc.X-(deskDepth/2), loc.Y, loc.Z)#.ToPoint()\r\n\r\nhit1 = rI.FindNearest(deskpoint1, XYZ(1,0,0))\r\nhit2 = rI.FindNearest(deskpoint2, XYZ(-1,0,0))\r\n\r\n\r\ndis1 = round(hit1.Proximity*304.8)\r\ndis2 = round(hit2.Proximity*304.8)\r\nstd = 50\r\n\r\n\r\nif dis1<dis2:\r\n    if dis1 != 50/304.8:\r\n        ElementTransformUtils.MoveElement(doc, desk.Id, XYZ((dis1-std)/304.8, 0, 0))\r\nelse:\r\n    if dis2 != 50/304.8:\r\n        ElementTransformUtils.MoveElement(doc, desk.Id, XYZ(-(dis2-std)/304.8, 0, 0))\r\n   \r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# ==========================\r\n# OUTPUT\r\n# ==========================\r\n\r\nOUT = loc",
      "Engine": "CPython3",
