    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\nimport clr\r\nimport sys\r\n\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.DB.Plumbing import *\r\n\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n    if isinstance(obj1,(list, tuple, set)): return obj1\r\n    else: return [obj1]\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\nelement = UnwrapElement(IN[0])\r\n\r\n# ==========================\r\n# CODE\r\n# ==========================\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nrevitLinks = FilteredElementCollector(doc).OfClass(RevitLinkInstance).ToElements()\r\n\r\nfor revitLink in revitLinks:\r\n    linkdoc = revitLink.GetLinkDocument()\r\n    if linkdoc.Title == \"MEP Model\":\r\n        mepdoc = linkdoc\r\n        \r\n\"\"\"\r\nducts = FilteredElementCollector(mepdoc).OfClass(Duct).ToElements()\r\ntypemarks = []\r\nfor duct in ducts:\r\n    typId = duct.GetTypeId()\r\n    ductType = mepdoc.GetElement(typId)\r\n    param = ductType.LookupParameter(\"Type Comments\").AsString()\r\n    typemarks.append(param)\r\n \"\"\"  \r\n\r\nwalls = FilteredElementCollector(doc).OfClass(Wall).ToElements()\r\n\r\n\r\nviewFamilyTypes = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n\r\nfor viewFamilyType in viewFamilyTypes:\r\n    if viewFamilyType.LookupParameter(\"Type Name\").AsString() == \"3D View\":\r\n        viewtype = viewFamilyType\r\n        \r\nclassList = List[System.Type]()\r\nclassList.Add(Duct)\r\nclassList.Add(CableTray)\r\nclassList.Add(Pipe)\r\n\r\nclassFilter = ElementMulticlassFilter(classList)\r\n\r\nclashes = []\r\nclashNumber = 1\r\nextent = 500/304.8\r\n\r\nfor wall in walls:\r\n    bb = wall.get_BoundingBox(None)\r\n    bbo  =BoundingBoxIntersectsFilter(Outline(bb.Min, bb.Max))\r\n    solid = wall.get_Geometry(Options())\r\n    solidli = list(solid)[0]\r\n    sfilter = ElementIntersectsSolidFilter(solidli)\r\n    clash = FilteredElementCollector(mepdoc).WherePasses(classFilter).WherePasses(bbo).WherePasses(sfilter).ToElements()\r\n    if len(clash)>0:\r\n        clashView = View3D.CreateIsometric(doc, viewtype.Id)\r\n        clashView.Name = \"Clash View \" +str(clashNumber)+\"_\"+ str(len(clash)) + \"No's\"\r\n        clashView.DetailLevel = ViewDetailLevel.Fine  \r\n        minX = bb.Min.X-extent\r\n        minY = bb.Min.Y-extent\r\n        minZ = bb.Min.Z-extent\r\n        maxX = bb.Max.X+extent\r\n        maxY = bb.Max.Y+extent\r\n        maxZ = bb.Max.Z+extent\r\n        newbb = BoundingBoxXYZ()\r\n        newbb.Min = XYZ(minX, minY, minZ)\r\n        newbb.Max = XYZ(maxX, maxY, maxZ)\r\n        clashView.SetSectionBox(newbb)\r\n        clashes.append([wall, clash])\r\n        clashNumber = clashNumber+1\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n# ==========================\r\n# OUTPUT\r\n# ==========================\r\nOUT = clashes",
      "Engine": "CPython3",
