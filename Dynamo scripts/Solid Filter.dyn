    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\nimport clr\r\nimport sys\r\n\r\n# Revit API\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# Optional Namespaces\r\nfrom Autodesk.Revit.DB.Architecture import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Plumbing import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\n\r\n# Dynamo Services\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"System\")\r\nfrom System import Type\r\nfrom System.Collections.Generic import List\r\n\r\n# Dynamo Geometry (Only if needed)\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\nuidoc = uiapp.ActiveUIDocument\r\napp = uiapp.Application\r\n\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\nwall = UnwrapElement(IN[0])\r\n\r\n# ==========================\r\n# CODE\r\n# ==========================\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nbb = wall.get_BoundingBox(None)\r\nbbo = Outline(bb.Min, bb.Max)\r\nclashfilter = BoundingBoxIntersectsFilter(bbo)\r\n\r\ncatlist = List[Type]()\r\ncatlist.Add(Duct)\r\ncatlist.Add(Pipe)\r\ncatlist.Add(CableTray)\r\n\r\nelefilter = ElementMulticlassFilter(catlist)\r\n\r\nclashes = FilteredElementCollector(doc).WherePasses(elefilter).WherePasses(clashfilter).ToElements()\r\n\r\neleidlist = List[ElementId]()\r\neleidlist.Add(wall.Id)\r\nfor clash in clashes:\r\n    eleidlist.Add(clash.Id)\r\n\r\nviewFamilyTypes = FilteredElementCollector(doc).OfClass(ViewFamilyType)\r\nfor viewFamilyType in viewFamilyTypes:\r\n    if viewFamilyType.ViewFamily == ViewFamily.ThreeDimensional:\r\n        vt = viewFamilyType\r\n\r\nclashview = View3D.CreateIsometric(doc, vt.Id)\r\nclashview.Name = \"WallvsMEP\"\r\nclashview.IsolateElementsTemporary(eleidlist)\r\n\r\npipes = FilteredElementCollector(doc).OfClass(Pipe).WherePasses(clashfilter).ToElements()\r\n\r\npipesIds = [pipe.Id for pipe in pipes]\r\n\r\nos = OverrideGraphicSettings().SetProjectionLineColor(Color(255,0,0))\r\n\r\nfor pipesId in pipesIds:\r\n    clashview.SetElementOverrides( pipesId, os)\r\n\r\nTransactionManager.Instance.TransactionTaskDone() \r\n# ==========================\r\n# OUTPUT\r\n# ==========================\r\n\r\nOUT = clashview",
