    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\n\"\"\"\r\npublic bool Export(\r\n    string folder,\r\n    IList<ElementId> viewIds,\r\n    PDFExportOptions options\r\n)\"\"\"\r\n\r\nfolderPath = r\"C:\\Users\\Akryazz\\Downloads\\Exports\"\r\n\r\nsheets = FilteredElementCollector(doc).OfClass(ViewSheet).ToElements()\r\n\r\nsh = sheets[0]\r\n\r\n\r\npdfOpt = PDFExportOptions()\r\n\r\npdfOpt.AlwaysUseRaster = True\r\npdfOpt.ColorDepth = ColorDepthType.Color\r\npdfOpt.Combine = False\r\npdfOpt.ExportQuality = PDFExportQualityType.DPI4000\r\npdfOpt.HideCropBoundaries = True\r\npdfOpt.HideReferencePlane = True\r\npdfOpt.HideScopeBoxes = True\r\npdfOpt.HideUnreferencedViewTags = True\r\npdfOpt.MaskCoincidentLines = True\r\npdfOpt.PaperPlacement = PaperPlacementType.Center\r\n#pdfOpt.PaperFormat = ExportPaperFormat.\r\npdfOpt.PaperOrientation = PageOrientationType.Auto\r\npdfOpt.RasterQuality = RasterQualityType.High\r\npdfOpt.ReplaceHalftoneWithThinLines = True\r\npdfOpt.ViewLinksInBlue = False\r\npdfOpt.ZoomType = ZoomType.FitToPage\r\npdfOpt.Combine = True\r\n\r\nsetName = IN[0]\r\n\r\nsets = FilteredElementCollector(doc).OfClass(ViewSheetSet).ToElements()\r\n\r\n\r\n#-----PDF------\r\n\r\nfor set in sets:\r\n    if set.Name == setName:\r\n        mySet = set\r\n\r\nfor mySheet in mySet.OrderedViewList :\r\n    viewIdList = List[ElementId]()\r\n    viewIdList.Add(mySheet.Id)\r\n    pdfOpt.FileName =  \"CombinedPdf\"     \r\n    #doc.Export(folderPath, viewIdList, pdfOpt)\r\n\r\n\r\n\r\n#------DWG----\r\n\r\ndwgSetName = IN[1]\r\n\r\nfor set in sets:\r\n    if set.Name == dwgSetName:\r\n        myDwgSet = set\r\n\r\ndwgOpt = DWGExportOptions()\r\n\r\n\r\nfor mySheet in myDwgSet.OrderedViewList :\r\n    viewIdList = List[ElementId]()\r\n    viewIdList.Add(mySheet.Id)\r\n    dwgName = mySheet.SheetNumber + \"-\" + mySheet.Name\r\n    #doc.Export(folderPath, dwgName, viewIdList, dwgOpt)\r\n    \r\n\r\nimport os\r\n\r\nfolder_name = folderPath + \"\\\\\" + \"new_folder\"\r\n\r\nos.mkdir(folder_name)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = folder_name",
