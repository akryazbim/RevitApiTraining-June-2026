    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Standard Dynamo Python Script template\nimport clr\n\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nclr.AddReference('RevitNodes')\n\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Plumbing import Pipe, PipeType\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\n# Inputs from connected nodes are available via IN list\n# IN[0] - wall (Element)\n# IN[1] - document (Document)\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n\nwall = UnwrapElement(IN[0])\n\n# Get the wall's solid geometry\nopt = Options()\nopt.ComputeReferences = True\nopt.IncludeNonVisibleObjects = False\nopt.DetailLevel = ViewDetailLevel.Coarse\nopt.IncludeHiddenElements = False\n\ngeomElem = wall.get_Geometry(opt)\n\n# Find the solid from the geometry\nsolid = None\nfor geo in geomElem:\n    if isinstance(geo, Solid):\n        if geo.Volume > 0:\n            solid = geo\n            break\n    elif isinstance(geo, GeometryInstance):\n        inst = geo.GetInstanceGeometry()\n        for g in inst:\n            if isinstance(g, Solid):\n                if g.Volume > 0:\n                    solid = g\n                    break\n\n# Get the bounding box of the wall\nbbox = wall.get_BoundingBox(None)\n\nif bbox is None or solid is None:\n    OUT = []\nelse:\n    # Expand the bounding box by 25mm (0.025 meters)\n    tolerance = 0.025  # 25mm in meters\n    minPt = bbox.Min\n    maxPt = bbox.Max\n    newMin = XYZ(minPt.X - tolerance, minPt.Y - tolerance, minPt.Z - tolerance)\n    newMax = XYZ(maxPt.X + tolerance, maxPt.Y + tolerance, maxPt.Z + tolerance)\n    scaledBbox = BoundingBoxXYZ()\n    scaledBbox.Min = newMin\n    scaledBbox.Max = newMax\n\n    # Create a solid from the scaled bounding box using Solid.CreateBox\n    scaledSolid = Solid.CreateBox(scaledBbox)\n\n    # Create filters\n    bboxFilter = BoundingBoxIntersectsFilter(scaledBbox)\n    solidFilter = ElementIntersectsSolidFilter(scaledSolid)\n\n    # Get all pipe elements and apply bounding box filter first\n    collector = FilteredElementCollector(doc)\n    pipes = collector.OfCategory(BuiltInCategory.OST_PipeCurves).WhereElementIsNotElementType().WherePasses(bboxFilter).ToElements()\n\n    # Apply solid filter to get elements that actually intersect\n    intersectingElements = []\n    for pipe in pipes:\n        if solidFilter.PassesFilter(pipe):\n            # Exclude the wall itself (though pipes shouldn't match wall Id)\n            if pipe.Id != wall.Id:\n                intersectingElements.append(pipe)\n\n    OUT = intersectingElements",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b6166cb9ccb947a29fcf37d585dcf2e0",
