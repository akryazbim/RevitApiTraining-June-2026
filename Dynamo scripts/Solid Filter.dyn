    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nexcelInp = tolist(UnwrapElement(IN[0]))\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\n\r\nviews = FilteredElementCollector(doc).OfClass(View).ToElements()\r\n\r\nplans = FilteredElementCollector(doc).OfClass(ViewPlan).ToElements()\r\n\r\n\r\n\"\"\"\r\npublic static ViewPlan Create(\r\n    Document document,\r\n    ElementId viewFamilyTypeId,\r\n    ElementId levelId\r\n)\r\n\"\"\"\r\n\r\nvfts = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n\r\n\r\nfor vft in vfts:\r\n    if vft.ViewFamily == ViewFamily.FloorPlan:\r\n        floorPlanType = vft\r\n         \r\n     \r\n\r\nlevels = FilteredElementCollector(doc).OfClass(Level).ToElements()\r\n\r\n\"\"\"\"\r\n\r\nfor level in levels:\r\n    if level.Name == \"Level 0\":\r\n        level0 = level\r\n        \r\nfor level in levels:\r\n    newFloorPlan = ViewPlan.Create(doc, floorPlanType.Id, level.Id)\r\n    newFloorPlan.Name = \"Babu's View\" + level.Name\r\n\r\n\"\"\"\r\nrows = excelInp[1:]\r\n\r\nlevelsToCreate = [row[5] for row in rows]\r\nviewNames = [row[3] for row in rows]\r\n#levelsToCreate = [0]\r\n#viewNames = [\"GFPlan\", \"FFPlan\"]\r\n\r\nfor levelToCreate, viewName in zip(levelsToCreate,viewNames):\r\n    level = next((i for i in levels if i.Name == levelToCreate),None)\r\n    if level is None:\r\n        continue\r\n    newFloorPlan = ViewPlan.Create(doc, floorPlanType.Id, level.Id)\r\n    newFloorPlan.Name = viewName+\"_\"+levelToCreate\r\n\r\n\"\"\"\r\n public static ViewSheet Create(\r\n    Document document,\r\n    ElementId titleBlockTypeId\r\n)\r\n\r\n\"\"\"\r\n\r\ntitleBlockTypes = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_TitleBlocks).WhereElementIsElementType().ToElements()\r\n\r\n\r\nfor ttBlockType in titleBlockTypes:\r\n    if ttBlockType.LookupParameter(\"Type Name\").AsString() == \"Standard\":\r\n        myTt = ttBlockType\r\n        \r\n\r\nsheetNames = [row[0] for row in rows]\r\nsheetNumbers = [row[1] for row in rows]\r\n\r\nfor sheetName, sheetNumber in zip(sheetNames, sheetNumbers):\r\n    newSheet = ViewSheet.Create(doc, myTt.Id)\r\n    newSheet.Name = sheetName\r\n    newSheet.SheetNumber = sheetNumber\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newSheet\r\n",
