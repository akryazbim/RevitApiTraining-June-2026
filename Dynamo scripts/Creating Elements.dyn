    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\n#dls = tolist(UnwrapElement(IN[0]))\r\n\r\ndynLine = IN[0]\r\nwt = UnwrapElement(IN[1])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\"\"\"\r\npublic static Wall Create(\r\n    Document document,\r\n    Curve curve,\r\n    ElementId levelId,\r\n    bool structural\r\n)\"\"\"\r\n\r\n\r\n\r\nlevels = FilteredElementCollector(doc).OfClass(Level).ToElements()   \r\nfor level in levels:\r\n    if level.Name == \"Level 0\":\r\n        level0 = level\r\n        \r\n\"\"\"\r\nfor dl in dls:\r\n    curve = dl.Location.Curve \r\n    newWall = Wall.Create(doc, curve, level0.Id, False)\r\n\"\"\"\r\n\r\nrvtLine = dynLine.ToRevitType()\r\n\r\n#newWall = Wall.Create(doc, rvtLine, level0.Id, False)\r\n\r\n\r\n\r\n\r\n\r\n\"\"\"\r\npublic static Wall Create(\r\n    Document document,\r\n    Curve curve,\r\n    ElementId wallTypeId,\r\n    ElementId levelId,\r\n    double height,\r\n    double offset,\r\n    bool flip,\r\n    bool structural\r\n)\"\"\"\r\n\r\nlevels = FilteredElementCollector(doc).OfClass(Level).ToElements()   \r\nfor level in levels:\r\n    if level.Name == \"Level 0\":\r\n        level0 = level\r\n    if level.Name == \"Level 1\":\r\n        level1 = level\r\n\r\nrvtLine = dynLine.ToRevitType()\r\n\r\n\r\nwallTypes = FilteredElementCollector(doc).OfClass(WallType).ToElements()\r\n\r\nfor wallType in wallTypes:\r\n    if wallType.LookupParameter(\"Type Name\").AsString() == \"Concrete Wall\":\r\n        cw = wallType\r\n\r\n\r\nnewWall = Wall.Create(doc, rvtLine, wt.Id, level0.Id, 3500/304.8, -500/304.8, False, True)\r\n\r\n\r\n\r\nnewWall.LookupParameter(\"Top Constraint\").Set(level1.Id)\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newWall",
