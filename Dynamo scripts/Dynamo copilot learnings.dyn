    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Standard Dynamo Python Script template\nimport clr\n\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nclr.AddReference('RevitNodes')\n\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.UI import *\nfrom RevitServices.Persistence import DocumentManager\n\n# Inputs from connected nodes are available via IN list\n# IN[0]: List of element ID integers\ninput_ids = IN[0]\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n\nsuccess = False\n\nif uidoc and input_ids is not None:\n    # Ensure input is treated as a list\n    if not isinstance(input_ids, list):\n        input_ids = [input_ids]\n        \n    try:\n        # Convert integer list to Revit ElementId objects\n        element_ids = []\n        for id_int in input_ids:\n            if isinstance(id_int, int) or str(id_int).isdigit():\n                element_ids.append(ElementId(int(id_int)))\n        \n        # Select the elements in the UI\n        # System.Collections.Generic.List is required for SetElementIds in Revit API\n        import System\n        from System.Collections.Generic import List\n        \n        id_list = List[ElementId](element_ids)\n        uidoc.Selection.SetElementIds(id_list)\n        \n        # Refresh the active view to display the selection\n        uidoc.RefreshActiveView()\n        success = True\n    except Exception:\n        success = False\n\n# Output must be assigned to OUT\nOUT = success",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "aed7225ef92d4bd0add6f6fac60e5875",
