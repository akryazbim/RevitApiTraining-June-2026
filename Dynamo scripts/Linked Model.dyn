  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nele = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\ngeo = list(ele.get_Geometry(Options()))[0]\r\n\r\nsolids = geo.GetInstanceGeometry()\r\n\r\nfor solid in solids:\r\n    if solid.Volume != 0:\r\n        colSolid = solid\r\n        break\r\n\r\nsolidFilt = ElementIntersectsSolidFilter(colSolid)\r\n\r\nbb = ele.get_BoundingBox(None)\r\nbbFilt = BoundingBoxIntersectsFilter(Outline(bb.Min, bb.Max))\r\n\r\n\r\nclashes = FilteredElementCollector(doc).OfClass(Ceiling).WherePasses(bbFilt).WherePasses(solidFilt).ToElements()\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nlinks = FilteredElementCollector(doc).OfClass(RevitLinkInstance).ToElements()\r\n\r\ntemp = []\r\n\r\nfor link in links:\r\n    linkDoc = link.GetLinkDocument()\r\n    if linkDoc.Title == \"MEP Model\":\r\n        mepDoc = linkDoc\r\n\r\nducts = FilteredElementCollector(mepDoc).OfClass(Duct).ToElements()\r\n\r\nvalues = []\r\n\r\nfor duct in ducts:\r\n    param = duct.LookupParameter(\"Comments\")\r\n    paramValue = param.AsString()\r\n    values.append(paramValue)\r\n  \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\ntemp = []    \r\n\r\nwalls = FilteredElementCollector(doc).OfClass(Wall).ToElements()\r\n\r\nfor wall in walls:\r\n    bb = wall.get_BoundingBox(None)\r\n    bbFilt = BoundingBoxIntersectsFilter(Outline(bb.Min, bb.Max))\r\n    \r\n    geo = wall.get_Geometry(Options())\r\n    \r\n    solid = list(geo)[0]\r\n    \r\n    solidFilt = ElementIntersectsSolidFilter(solid)\r\n    \r\n    clashes = FilteredElementCollector(mepDoc).OfClass(Duct).WherePasses(bbFilt).WherePasses(solidFilt).ToElements()\r\n    \r\n    if len(clashes) > 0:\r\n        temp.append([wall, clashes])\r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n\r\nOUT = temp",
      "Engine": "CPython3",
      "VariableInputPorts": true,
