    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\nviews = FilteredElementCollector(doc).OfClass(View).ToElements()\r\n\r\n#doc.ActiveView.CropBoxActive = True\r\nplanViews = FilteredElementCollector(doc).OfClass(View3D).ToElements()\r\n\r\n\r\n\"\"\"\r\npublic static ViewPlan Create(\r\n    Document document,\r\n    ElementId viewFamilyTypeId,\r\n    ElementId levelId\r\n)\"\"\"\r\n\r\n\r\nvfts = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n\r\n\r\nfor vft in vfts:\r\n    if vft.ViewFamily == ViewFamily.FloorPlan:\r\n        floorPlanType = vft\r\n\r\n\r\nlevels = FilteredElementCollector(doc).OfClass(Level).ToElements()\r\n\r\nlevel0 = [i for i in levels if i.Name == \"Level 0\"][0]\r\n\r\nlevelsToCreate = [ \"Level 0\", \"Level 1\" ]\r\nviewNames = [\"Iron Man\", \"Bat Man\"]\r\n\r\n\r\n\"\"\"\r\nfor level in levels:\r\n    newFloorPlan = ViewPlan.Create(doc, floorPlanType.Id, level.Id)\r\n    newFloorPlan.Name = \"Ashim's View-\"+level.Name\r\n\r\n#level = [i for i in levels if i.Name == levelToCreate][0]\r\n\r\nfor levelToCreate, viewName in zip(levelsToCreate,viewNames) :\r\n    for level in levels:\r\n        if level.Name == levelToCreate:\r\n            newFloorPlan = ViewPlan.Create(doc, floorPlanType.Id, level.Id)\r\n            newFloorPlan.Name = viewName\r\n\"\"\"\r\n\r\n\"\"\"\r\npublic static ViewSheet Create(\r\n    Document document,\r\n    ElementId titleBlockTypeId\r\n)\"\"\"\r\n\r\n\r\nttBlockTypes = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_TitleBlocks).WhereElementIsElementType().ToElements()\r\n\r\n\r\nfor tt in ttBlockTypes:\r\n    if tt.LookupParameter(\"Type Name\").AsString() == \"Standard\":\r\n        myTt = tt\r\n\r\n\r\n\r\n\"\"\"\r\npublic static Viewport Create(\r\n    Document document,\r\n    ElementId viewSheetId,\r\n    ElementId viewId,\r\n    XYZ point\r\n)\"\"\"\r\n\r\n\"\"\"\r\nsheets = FilteredElementCollector(doc).OfClass(ViewSheet).ToElements()\r\n\r\nfor sheet in sheets:\r\n    if sheet.Name == \"Ronak\" and sheet.SheetNumber == \"07\":\r\n        mySheet = sheet\r\n\r\n\r\nplans = FilteredElementCollector(doc).OfClass(ViewPlan).ToElements()\r\n\r\nfor plan in plans:\r\n    if plan.Name == \"Bat Man\":\r\n        myPlan = plan\r\n        \r\n        \r\nnewViewPort = Viewport.Create(doc, mySheet.Id, myPlan.Id, XYZ(1,1,0))\r\n\"\"\"\r\n\r\n\r\n\r\n\r\nsheetNames = IN[0]\r\nsheetNumbers = IN[1]\r\nttNames = IN[2]\r\nviewNames = IN[3]\r\n\r\nplans = FilteredElementCollector(doc).OfClass(ViewPlan).ToElements()\r\n\r\nfor name, number, ttName, viewName in zip(sheetNames, sheetNumbers, ttNames, viewNames): \r\n   for tt in ttBlockTypes:\r\n    if tt.LookupParameter(\"Type Name\").AsString() == ttName:\r\n        myTt = tt\r\n    newSheet = ViewSheet.Create(doc, myTt.Id)\r\n    newSheet.Name = name\r\n    newSheet.SheetNumber = number\r\n    for plan in plans:\r\n        if plan.Name == viewName:\r\n            myPlan = plan\r\n    newViewPort = Viewport.Create(doc, newSheet.Id, myPlan.Id, XYZ(1,1,0))\r\n    \r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newViewPort",
