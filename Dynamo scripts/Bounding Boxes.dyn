    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nele = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ncatList = List[BuiltInCategory]()\r\ncatList.Add(BuiltInCategory.OST_DuctCurves)\r\ncatList.Add(BuiltInCategory.OST_CableTray)\r\ncatList.Add(BuiltInCategory.OST_PipeCurves)\r\n\r\n\r\ncatFilter = ElementMulticategoryFilter(catList)\r\n\r\n\r\nbb = ele.get_BoundingBox(None)\r\n\r\not = Outline(bb.Min, bb.Max)\r\n\r\nbbFilter = BoundingBoxIntersectsFilter(ot)\r\n\r\nclashes = FilteredElementCollector(doc).WherePasses(catFilter).WherePasses(bbFilter).ToElements()\r\n\"\"\"\r\nwallComments = ele.LookupParameter(\"Comments\").AsString()\r\n\r\nfor clash in clashes:\r\n    clash.LookupParameter(\"Comments\").Set(wallComments)\r\n\r\n\"\"\"\r\n\"\"\"\r\npublic static View3D CreateIsometric(\r\n    Document document,\r\n    ElementId viewFamilyTypeId\r\n)\r\n  \r\nvfts = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\n\r\nfor vft in vfts:\r\n    if vft.ViewFamily == ViewFamily.ThreeDimensional:\r\n        view3DType = vft\r\n\r\nnew3dView = View3D.CreateIsometric(doc, view3DType.Id)\r\nnew3dView.Name = \"Clash View-\"+str(ele.Id.IntegerValue)\r\n\r\nidList = List[ElementId]()\r\nfor clash in clashes:\r\n    idList.Add(clash.Id)\r\n\r\nidList.Add(ele.Id)\r\n\r\nnew3dView.IsolateElementsTemporary(idList)\r\n\"\"\"\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = view3DType",
