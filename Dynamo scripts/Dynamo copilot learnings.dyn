    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Standard Dynamo Python Script template\nimport clr\n\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nclr.AddReference('RevitNodes') # Contains Revit.Elements and ElementWrapper\n\nfrom Autodesk.Revit.DB import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\n# Explicitly import ElementWrapper and its UnwrapElement method\n# This is the most reliable method when direct import fails\nimport Revit\nclr.ImportExtensions(Revit.Elements) # This makes .ToDSType(bool) and .InternalElement available\n# However, for unwrapping, ElementWrapper.UnwrapElement is more direct\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n\n# Inputs from connected nodes\n# IN[0] expects a single Wall element\ninput_wall = IN[0]\n\nworkset_name = \"Workset Not Found\"\n\nif input_wall is not None:\n    # Use ElementWrapper.UnwrapElement to get the native Revit Element\n    # This method is generally very reliable for unwrapping Dynamo elements\n    wall = input_wall.InternalElement # This is the most direct way to get the internal Revit API element from a Dynamo wrapper.\n    \n    if wall is not None:\n        # Get the WorksetId of the wall\n        workset_id = wall.WorksetId\n        \n        # Verify the document is workshared and the WorksetId is valid\n        if doc.IsWorkshared and workset_id != WorksetId.InvalidWorksetId:\n            workset_table = doc.GetWorksetTable()\n            if workset_table:\n                workset = workset_table.GetWorkset(workset_id)\n                if workset is not None:\n                    workset_name = workset.Name\n        else:\n            workset_name = \"Non-Workshared Document or Invalid WorksetId\"\n    else:\n        workset_name = \"Input element could not be unwrapped.\"\n\n# Output must be assigned to OUT\nOUT = workset_name",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6cf6e8e22a61418bb5501561405cd7e0",
