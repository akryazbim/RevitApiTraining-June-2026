  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nele = UnwrapElement(IN[0])\r\ndl = UnwrapElement(IN[1])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\"\"\"\r\ni = 1\r\n\r\nwhile i <= 5:  \r\n    vec = XYZ(i*5000/304.8, 0, 0)  \r\n    ElementTransformUtils.CopyElement(doc, ele.Id, vec)\r\n    i = i + 1\r\n\"\"\"\r\n\r\n\"\"\"\r\nfor i in range(1, 6):\r\n    vec = XYZ(i*5000/304.8, 0, 0)  \r\n    ElementTransformUtils.CopyElement(doc, ele.Id, vec)\r\n\"\"\"\r\n\r\n\"\"\"\r\npublic static void MoveElement(\r\n    Document document,\r\n    ElementId elementToMove,\r\n    XYZ translation\r\n)\"\"\"\r\n\r\n#vec = XYZ(5000/304.8, 0, 0)  \r\n#ElementTransformUtils.MoveElement(doc, ele.Id, vec)\r\n\r\n\"\"\"\r\ncenter = arc.Location.Curve.Center\r\n\r\nele.Location.Point = center\r\n\"\"\"\r\n\r\n\"\"\"\r\npublic static void RotateElement(\r\n    Document document,\r\n    ElementId elementToRotate,\r\n    Line axis,\r\n    double angle\r\n)\"\"\"\r\n\r\n\"\"\"\r\n\r\ncorner = ele.Location.Point\r\n\r\nendPoint = XYZ(corner.X, corner.Y, corner.Z + 10)\r\n\r\naxis = Line.CreateBound(corner, endPoint)\r\n\r\nElementTransformUtils.RotateElement(doc, ele.Id, axis, 45*0.0174533)\r\n\r\n\"\"\"\r\n\r\n\"\"\"\r\npublic static void MirrorElement(\r\n    Document document,\r\n    ElementId elementToMirror,\r\n    Plane plane\r\n)\"\"\"\r\n\r\n\r\norigin = dl.Location.Curve.GetEndPoint(0)\r\n\r\nnormal = XYZ(1,0,0)\r\n\r\nplane = Plane.CreateByNormalAndOrigin(normal, origin)\r\n\r\n\r\nElementTransformUtils.MirrorElement(doc, ele.Id, plane)\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = plane",
      "Engine": "CPython3",
