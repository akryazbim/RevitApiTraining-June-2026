    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Standard Dynamo Python Script template\nimport clr\n\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nclr.AddReference('RevitNodes')\n\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Electrical import *\nfrom RevitServices.Persistence import DocumentManager\n\n# Inputs from connected nodes\nlighting_fixture = IN[0]\n\ndoc = DocumentManager.Instance.CurrentDBDocument\n\n# Unwrap Dynamo element to get the native Revit element\nif hasattr(lighting_fixture, \"InternalElement\"):\n    revit_fixture = lighting_fixture.InternalElement\nelse:\n    revit_fixture = lighting_fixture\n\noutput_point = None\n\nif revit_fixture is not None:\n    # 1. Retrieve the location point of the lighting fixture in internal coordinates\n    location = revit_fixture.Location\n    \n    if isinstance(location, LocationPoint):\n        internal_xyz = location.Point\n        \n        # 2. Get the active project's Survey Point element\n        # In Revit, the Survey Point is a BasePoint element where IsShared is True\n        collector = FilteredElementCollector(doc).OfClass(BasePoint)\n        survey_point = None\n        for bp in collector:\n            if bp.IsShared: # IsShared == True represents the Survey Point\n                survey_point = bp\n                break\n        \n        if survey_point is not None:\n            # 3. Retrieve the Survey Point's position relative to the internal origin\n            # In Revit 2020+, we can use the SharedPosition property\n            survey_xyz = survey_point.SharedPosition\n            \n            # 4. Subtract the Survey Point's offset from the internal coordinate\n            # (Internal Position - Survey Point Position)\n            relative_x = internal_xyz.X - survey_xyz.X\n            relative_y = internal_xyz.Y - survey_xyz.Y\n            relative_z = internal_xyz.Z - survey_xyz.Z\n            \n            output_point = XYZ(relative_x, relative_y, relative_z)\n\n# Output must be assigned to OUT\nOUT = output_point",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ac7e7a192d814fddbb34f32da77d1c14",
      "NodeType": "PythonScriptNode",
      "Inputs": [
