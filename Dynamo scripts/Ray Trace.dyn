    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\nimport clr\r\nimport sys\r\n\r\nsys.path.append(r'C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nfrom System import*\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.DB.Plumbing import *\r\n\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n    if isinstance(obj1,(list, tuple, set)): return obj1\r\n    else: return [obj1]\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\ndl = UnwrapElement(IN[0])\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\norigin = dl.Location.Curve.Center\r\n\r\npt = XYZ(origin.X, origin.Y, origin.Z+0.6)\r\n\r\ndir = XYZ(1,0,0)\r\n\r\nviews = FilteredElementCollector(doc).OfClass(View3D).ToElements()\r\n\r\nfor view in views:\r\n    if view.Name == \"{3D}\":\r\n        myView = view\r\n        \r\n\"\"\"\r\npublic ReferenceIntersector(\r\n    ElementFilter filter,\r\n    FindReferenceTarget targetType,\r\n    View3D view3d\r\n)\"\"\"\r\n\r\ncatFilt = ElementCategoryFilter(BuiltInCategory.OST_Walls)\r\n\r\nri = ReferenceIntersector(catFilt, FindReferenceTarget.Element, myView)\r\n\r\nhit = ri.FindNearest(pt, dir)\r\n\r\ndistance = hit.Proximity\r\n\r\nref = hit.GetReference()\r\n\r\nhitPoint = ref.GlobalPoint\r\n\r\nele = doc.GetElement(ref.ElementId)\r\n\r\n\r\nhits = ri.Find(pt, dir)\r\n\r\nelements = []\r\n\r\nfor h in hits:\r\n    distance = h.Proximity\r\n    ref = h.GetReference()\r\n    \r\n    hitPoint = ref.GlobalPoint\r\n    \r\n    ele = doc.GetElement(ref.ElementId)\r\n    elements.append(hitPoint.ToPoint()) \r\n\r\n\r\n\r\ndl2 = UnwrapElement(IN[1])\r\n\r\nbotPoint = dl2.Location.Curve.Center\r\n\r\ncatFilt = ElementCategoryFilter(BuiltInCategory.OST_Ceilings)\r\n\r\nri = ReferenceIntersector(catFilt, FindReferenceTarget.Element, myView)\r\n\r\nhit = ri.FindNearest(botPoint, XYZ(0,0,1))\r\n\r\ndistance = hit.Proximity\r\n\r\nref = hit.GetReference()\r\n\r\nhitPoint = ref.GlobalPoint\r\n\r\nele = doc.GetElement(ref.ElementId)\r\n\r\n\"\"\"public FamilyInstance NewFamilyInstance(\r\n    XYZ location,\r\n    FamilySymbol symbol,\r\n    Element host,\r\n    Level level,\r\n    StructuralType structuralType\r\n)\"\"\"\r\n\r\n\r\nlightingTypes = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_LightingFixtures).WhereElementIsElementType().ToElements()\r\n\r\nfor lt in lightingTypes:\r\n    if lt.LookupParameter(\"Type Name\").AsString() == \"100W - 230V\":\r\n        ceilingLt = lt\r\n\r\nlevel = doc.GetElement(ele.LevelId)\r\n\r\nif ceilingLt.IsActive == False:\r\n    ceilingLt.Activate()\r\n\r\n\r\nnewLight = doc.Create.NewFamilyInstance(hitPoint, ceilingLt, ele, level, StructuralType.NonStructural)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newLight",
      "Engine": "CPython3",
      "VariableInputPorts": true,
