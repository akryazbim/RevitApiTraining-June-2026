      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfec = FilteredElementCollector(doc)\r\n\r\nwalls = FilteredElementCollector(doc).OfClass(Wall).ToElements()\r\n\r\nducts = FilteredElementCollector(doc).OfClass(Duct).ToElements()\r\n\r\ncpValues = []\r\nfor wall in walls: cpValues.append(wall.Name)   \r\n     \r\n    \r\nnames = [i.LookupParameter(\"Comments\").AsString()  for i in walls]\r\n\r\n\r\nactiveView = doc.ActiveView\r\n\r\nwallsInCurrentView = FilteredElementCollector(doc, activeView.Id).OfClass(Wall).ToElements()\r\n\r\n\r\ncatList = List[BuiltInCategory]()\r\ncatList.Add(BuiltInCategory.OST_Walls)\r\ncatList.Add(BuiltInCategory.OST_DuctCurves)\r\ncatList.Add(BuiltInCategory.OST_CableTray)\r\n\r\n\r\ncatFilt = ElementMulticategoryFilter(catList)\r\n\r\n\r\nfec = FilteredElementCollector(doc).WherePasses(catFilt).WhereElementIsNotElementType().ToElements()\r\n\r\nallLevels = FilteredElementCollector(doc).OfClass(Level).ToElements()\r\n\r\nlevel0 = None\r\n\r\nfor level in allLevels:\r\n    if level.Name == \"Level 0\":\r\n        level0 = level\r\n\r\n\r\nlevelFilt = ElementLevelFilter(level0.Id)\r\n\r\n\r\nfec2 = FilteredElementCollector(doc).WherePasses(levelFilt).WherePasses(catFilt).ToElements()\r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = fec2",
