    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n    if isinstance(obj1,(list, tuple, set)): return obj1\r\n    else: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\"\"\"\r\nworksets = FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset) \r\n\r\nfor workset in worksets:\r\n    if workset.Name == \"Floors\":\r\n       wf = workset\r\n\r\n#worksetId = [i.Id for i in FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset).ToWorksets() if i.Name == \"Workset1\"][0]\r\n\r\newf = ElementWorksetFilter(wf.Id)\r\n\r\ncatlist = List[BuiltInCategory]()\r\ncatlist.Add(BuiltInCategory.OST_Walls)\r\ncatlist.Add(BuiltInCategory.OST_Ceilings)\r\n\r\nmce = ElementMulticategoryFilter(catlist)\r\n\r\nelements = FilteredElementCollector(doc).WherePasses(ewf).WherePasses(mce).ToElements()\r\n\"\"\"\r\n\r\nfTypes = [\"Desk1\", \"Desk2\", \"Desk3\", \"Desk4\", \"Desk5\", \"Desk1\", \"Desk2\"]\r\n\r\nf1 = \"Desk1\"\r\nf2 = \"Desk2\"\r\nf3 = \"Desk3\"\r\n\r\ntypeToCollect = [\"Desk1\", \"Desk2\", \"Desk3\"]\r\n\r\nmyList = []\r\n\r\nfor fType in fTypes:\r\n    #if fType == f1 or fType == f2 or fType == f3:\r\n    if fType in typeToCollect and fType.LookupParameter(\"Comments\").AsString() == \"Bat Man\":\r\n        myList.append(fType)\r\n\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\nOUT = myList",
