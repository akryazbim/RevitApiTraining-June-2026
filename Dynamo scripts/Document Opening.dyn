      "Code": "import clr\r\n\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\n\r\nimport System\r\nfrom System.Collections.Generic import *\r\n\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Mechanical import *\r\nfrom Autodesk.Revit.DB.Electrical import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\ndef tolist(obj1):\r\n\tif isinstance(obj1,(list, tuple, set)): return obj1\r\n\telse: return [obj1]\r\n\r\n#Preparing input from dynamo to revit\r\nfilaPaths = UnwrapElement(IN[0])\r\n\r\n\"\"\"\r\n#filePath = r\"C:\\Users\\Akryazz\\OneDrive\\Documents\\My Files\\Revit Api Training\\Python Revit API Training\\Revit Models\\2025\\MEP Model.rvt\"\r\n\r\nnewDoc = app.OpenDocumentFile(filePath)\r\n\r\n\r\nTransactionManager.Instance.EnsureInTransaction(newDoc)\r\n\r\n\r\nducts = FilteredElementCollector(newDoc).OfClass(Duct).ToElements()\r\n\r\nvalues = []\r\n\r\nfor duct in ducts:\r\n    param = duct.LookupParameter(\"Comments\")\r\n    paramValue = param.AsString()\r\n    param.Set(\"Dr.Doom\")\r\n    values.append(paramValue)\r\n\r\nTransactionManager.Instance.ForceCloseTransaction()\r\n\"\"\"\r\n\r\nfor filePath in filePaths:\r\n    newDoc = app.OpenDocumentFile(filePath)\r\n    exportFolderPath = r\"C:\\Users\\Akryazz\\Downloads\\Exports\"\r\n    \r\n    nwcOpt = NavisworksExportOptions()\r\n    \r\n    nwcName = newDoc.Title+\".nwc\"\r\n\r\n    newDoc.Export(exportFolderPath, nwcName, nwcOpt)\r\n\r\n\r\n\r\n#newDoc.Save()\r\n\r\n\r\nOUT = \"\"",
