    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ==========================\r\n# IMPORTS\r\n# ==========================\r\n\r\n import clr\r\n import sys\r\n\r\n# Revit API\r\n clr.AddReference(\"RevitAPI\")\r\n from Autodesk.Revit.DB import *\r\n from Autodesk.Revit.UI import *\r\n\r\n# Optional Namespaces\r\n from Autodesk.Revit.DB.Architecture import *\r\n from Autodesk.Revit.DB.Structure import *\r\n from Autodesk.Revit.DB.Mechanical import *\r\n from Autodesk.Revit.DB.Plumbing import *\r\n from Autodesk.Revit.DB.Electrical import *\r\n\r\n# Dynamo Services\r\n clr.AddReference(\"RevitServices\")\r\n from RevitServices.Persistence import DocumentManager\r\n from RevitServices.Transactions import TransactionManager\r\n\r\n clr.AddReference(\"System\")\r\n from System import Type\r\n from System.Collections.Generic import List\r\n\r\n# Dynamo Geometry (Only if needed)\r\n clr.AddReference(\"ProtoGeometry\")\r\n from Autodesk.DesignScript.Geometry import *\r\n\r\n# ==========================\r\n# DOCUMENTS\r\n# ==========================\r\n\r\n doc = DocumentManager.Instance.CurrentDBDocument\r\n uiapp = DocumentManager.Instance.CurrentUIApplication\r\n uidoc = uiapp.ActiveUIDocument\r\n app = uiapp.Application\r\n\r\n# ==========================\r\n# INPUTS\r\n# ==========================\r\n\r\n levelNames = UnwrapElement(IN[0])\r\n levelHeights = UnwrapElement(IN[1])\r\n sheetNumbers = UnwrapElement(IN[2])\r\n sheetNames = UnwrapElement(IN[3])\r\n titleBlocks = UnwrapElement(IN[4])\r\n\r\n# ==========================\r\n# CODE\r\n# ==========================\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nlevels = FilteredElementCollector(doc).OfClass(Level)\r\nnames = [level.Name for level in levels] \r\n\r\nviewFamilyTypes = FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements()\r\ntitleblocks = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_TitleBlocks).WhereElementIsElementType().ToElements()\r\n\r\ntb = {}\r\n\r\nfor titleblock in titleblocks:\r\n    typeName = titleblock.FamilyName\r\n    tb[typeName] = titleblock\r\n\r\nfor viewFamilyType in viewFamilyTypes:\r\n    if viewFamilyType.LookupParameter(\"Type Name\").AsString() == \"Architectural Plan\":\r\n        vt = viewFamilyType\r\n\r\nfor levelName, levelHeight, sheetNumber, sheetName, titleBlock in zip(levelNames, levelHeights, sheetNumbers, sheetNames, titleBlocks):\r\n    if levelName not in names:\r\n        newLevel = Level.Create(doc, levelHeight/304.8)\r\n        newLevel.Name = levelName\r\n    newView = ViewPlan.Create(doc, vt.Id, newLevel.Id)\r\n    newView.Name = levelName+\" - Architectural\"\r\n    newSheet = ViewSheet.Create(doc, tb[titleBlock].Id)\r\n    newSheet.SheetNumber = sheetNumber\r\n    newSheet.Name = sheetName\r\n    Viewport.Create(doc, newSheet.Id, newView.Id, XYZ(594/304.8, 420/304.8, 0))\r\n\r\nTransactionManager.Instance.TransactionTaskDone() \r\n# ==========================\r\n# OUTPUT\r\n# ==========================\r\n\r\nOUT = tb",
      "Engine": "CPython3",
